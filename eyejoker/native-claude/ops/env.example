# mode 600. Keep real values outside git.
ANTHROPIC_BASE_URL=http://172.17.0.1:8317
ANTHROPIC_API_KEY=replace-with-cliproxy-api-key
CLAUDE_CODE_OAUTH_TOKEN=
DISCORD_STATE_DIR=/home/ejclaw/.claude/channels/discord-owner
# Required only when claude-native-cohort-verifier.timer is enabled.
CLAUDE_NATIVE_COHORT_CHANNEL_ID=
# Bridge-owned Claude Code CLI.
#
# Strongly recommended. The Agent SDK pins an exact CLI cohort via its
# claudeCodeVersion field, and src/sdk-compat.ts fail-closes the bridge when the
# executable does not match. Leaving this unset falls back to
# ~/.hermes/node/bin/claude, which another tool may upgrade at any time -- that
# upgrade then puts the bridge into a boot loop until the SDK is bumped.
#
# Install a dedicated copy at the cohort version and point this at it:
#   mkdir -p ~/.local/share/native-claude-cli && cd ~/.local/share/native-claude-cli
#   # package.json needs "trustedDependencies": ["@anthropic-ai/claude-code"]
#   # or bun blocks the postinstall and the native binary is never downloaded
#   bun add @anthropic-ai/claude-code@<claudeCodeVersion>
# CLAUDE_NATIVE_CLAUDE_BIN=/home/ejclaw/.local/share/native-claude-cli/node_modules/@anthropic-ai/claude-code/bin/claude.exe
